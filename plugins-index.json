      "ref": "v0.3.0",
      "capabilities": [
        "card",
        "notify"
      ],
      "icon": "system-run",
      "emoji": "",
      "screenshot": "",
      "min_blueferry": "0.8.1",
      "api_version": 1
    },
    {
      "id": "io.weirdware.blueferry.calendar",
      "name": "Calendar",
      "description": "Your CalDAV agenda or iCal links (Google Calendar without sign-in) on BlueFerry's phone card.",
      "repo": "https://github.com/joshii-h/blueferry-plugin-calendar",
      "ref": "v0.3.1",
      "capabilities": [
        "card",
        "notify"
      ],
      "icon": "view-calendar",
      "emoji": "",
      "screenshot": "",
      "min_blueferry": "0.8.1",
      "api_version": 1
    },
    {
      "id": "io.weirdware.blueferry.webdav",
      "name": "WebDAV files",
