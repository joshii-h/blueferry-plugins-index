      "repo": "https://github.com/joshii-h/blueferry-plugin-webdav",
      "ref": "v0.2.2",
      "capabilities": [
        "card",
        "share",
        "notify"
      ],
      "icon": "folder-cloud",
      "emoji": "",
      "screenshot": "",
      "min_blueferry": "0.8.1",
      "api_version": 1
    },
    {
      "id": "io.weirdware.blueferry.localsend",
