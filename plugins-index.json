{
  "version": 1,
  "plugins": [
    {
      "id": "io.weirdware.blueferry.immich_photos",
      "name": "Immich photos",
      "description": "Recent photos and videos from your own Immich server in BlueFerry's Photos tab.",
      "repo": "https://github.com/joshii-h/blueferry-plugin-immich",
      "ref": "v0.3.1",
      "capabilities": [
        "photos"
      ],
      "icon": "folder-pictures",
      "emoji": "",
      "screenshot": "",
      "min_blueferry": "0.8.1",
      "api_version": 1
    },
    {
      "id": "io.weirdware.blueferry.shortcuts",
      "name": "iOS Shortcuts bridge",
      "description": "Clipboard, links and battery from your iPhone through iOS Shortcuts, set up with a QR code.",
